# --- Data and generated outputs: NEVER commit these -------------------------
# Raw logs (downloaded LogHub data, any personal logs)
data/*
!data/README.md

# Parsed logs, feature matrices, trained models
artifacts/*
!artifacts/.gitkeep

# Any stray log files (e.g. personal logs) anywhere except small test fixtures
*.log
!tests/fixtures/**/*.log
# Deliberate exception: small public HDFS demo log for the dashboard (see app/demo/README.md)
!app/demo/hdfs_demo.log
!app/demo/auth_demo.log

# --- Python -----------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Tools ------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Secrets and local settings ---------------------------------------------
.env
.streamlit/secrets.toml

# Editor: share only the project settings and recommended extensions
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS junk
Thumbs.db
.DS_Store

# Local Claude Code tool settings (dev server config for the preview browser)
.claude/

# Private notes (interview prep): never committed
notes/

# Quick-test outputs of the small sample configs (regenerated by the commands)
reports/*_sample/

# Working notes for Claude Code sessions (kept locally, not part of the portfolio)
CLAUDE.md
